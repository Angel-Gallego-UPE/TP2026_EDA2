void __fastcall TForm1::pbMapaPaint(TObject *Sender)
{
	TCanvas *c = pbMapa->Canvas;
	int w = pbMapa->Width;
	int h = pbMapa->Height;

	c->Brush->Color = clWhite;
	c->Pen->Color = clGray;
	c->Pen->Width = 5;
	c->Rectangle(0, 0, w, h);

	int n = vector_ciudades.size();
	if (n == 0)
	return;

	//se calculan límites X e Y para escalar cualquier coordenada al tamaño del mapa
	int minX = vector_ciudades[0].getX(), maxX = minX;
	int minY = vector_ciudades[0].getY(), maxY = minY;
	for (int i = 1; i < n; i++)
	{
		if (vector_ciudades[i].getX() < minX)
		minX = vector_ciudades[i].getX();

		if (vector_ciudades[i].getX() > maxX)
		maxX = vector_ciudades[i].getX();

		if (vector_ciudades[i].getY() < minY)
		minY = vector_ciudades[i].getY();

		if (vector_ciudades[i].getY() > maxY)
		maxY = vector_ciudades[i].getY();
	}

	int margen = 50;

	int rangoX = maxX - minX;
	if (rangoX == 0)
	rangoX = 1;

	int rangoY = maxY - minY;
	if (rangoY == 0)
	rangoY = 1;


	//convertimos cada ciudad a coordenadas en píxeles dentro de pbMapa
	std::vector<TPoint> pos(n);
	for (int i = 0; i < n; i++)
	{
		int px = margen + ((vector_ciudades[i].getX() - minX) * (w - 2 * margen)) / rangoX;
		int py = margen + ((vector_ciudades[i].getY() - minY) * (h - 2 * margen)) / rangoY;
		pos[i] = Point(px, py);
	}

	//se dibujan TODAS las conexiones existentes en gris claro
	c->Pen->Color = clSilver;
	c->Pen->Width = 2;
	c->Font->Color = clGray;
	c->Font->Size = 8;

	for (int i = 0; i < n; i++)
	{
		for (int j = i + 1; j < n; j++)
		{
			Ruta r = mi_grafo.getRuta(i, j);
			if (r.getruta_existe() && r.getestado_de_ruta())
			{
				c->MoveTo(pos[i].x, pos[i].y);
				c->LineTo(pos[j].x, pos[j].y);

				//se muestran kilómetros en el punto medio de la línea
				int midX = (pos[i].x + pos[j].x) / 2;
				int midY = (pos[i].y + pos[j].y) / 2;
				c->TextOut(midX, midY, FloatToStr(r.getdistancia()) + " km");
			}
		}
	}

	//se resaltan en azul/rojo el camino más corto según Dijkstra
	if (camino_actual.size() > 1)
	{
		c->Pen->Color = clRed;
		c->Pen->Width = 4;
		for (int k = 0; k < camino_actual.size() - 1; k++)
		{
			int u = camino_actual[k];
			int v = camino_actual[k + 1];
			c->MoveTo(pos[u].x, pos[u].y);
			c->LineTo(pos[v].x, pos[v].y);
		}
	}

	//se dibujan los nodos y los nombres de cada ciudad
	c->Font->Color = clBlack;
	c->Font->Style = TFontStyles() << fsBold;
	c->Font->Size = 9;
	c->Pen->Width = 2;

	for (int i = 0; i < n; i++)
	{
		//se verificar si la ciudad forma parte del camino más rápido
		bool enCamino = false;
		for (int k = 0; k < camino_actual.size() && !enCamino; k++)
		{
			if (camino_actual[k] == i)
			{
				enCamino = true;
			}
		}

        if (enCamino)
		{
			c->Brush->Color = clYellow;
			c->Pen->Color = clRed;
		}
		else
		{
			c->Brush->Color = clSkyBlue;
			c->Pen->Color = clNavy;
		}

		int radio = 10;
		c->Ellipse(pos[i].x - radio, pos[i].y - radio, pos[i].x + radio, pos[i].y + radio);

		String nombre = String(vector_ciudades[i].getNombre().c_str());
		c->Brush->Style = bsClear; //texto sin fondo tapando líneas
		c->TextOut(pos[i].x - 20, pos[i].y - 26, nombre);
		c->Brush->Style = bsSolid;
	}
}
