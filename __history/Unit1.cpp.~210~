bool TForm1::CalcularDijkstra(int origen, int destino, std::vector<int> &camino, double &distanciaTotal)
{
	int n = mi_grafo.obtener_cantidad_de_ciudades(); //obtengo la cantidad ciudades del grafo
	camino.clear(); //limpio el vector por si traía datos de una búsqueda anterior

	if (origen < 0 || origen >= n || destino < 0 || destino >= n || origen == destino)
		return false;

	const double INF = 1.7976931348623158e308; //valor máximo de double
	std::vector<double> dist(n, INF); //guarda la menor distancia acumulada desde el origen hacia cada ciudad
	std::vector<bool> visitado(n, false); //se guardan las ciudades que ya tienen su distancia mínima
	std::vector<int> anterior(n, -1);  //guarda el índice de la ciudad anterior
    bool terminado=false;
	dist[origen] = 0; //al ser la misma ciudad la distancia es 0 (o '-')

	//se fija el camino mínimo hacia una ciudad nueva en cada vuelta
	for (int count = 0; count < n; count++)
	{
		int u = -1; //guardará el índice de la ciudad no visitada más cercana
		double minDist = INF;

        //busco entre las ciudades no visitadas cuál tiene la menor distancia acumulada
		for (int i = 0; i < n; i++)
		{
			if (!visitado[i] && dist[i] < minDist)
			{
				minDist = dist[i];
				u = i;
			}
		}
		//si no quedan ciudades alcanzables o ya estamos en destino, entonces está terminado
		if (u == -1 || u == destino)
		{
			terminado = true;
		}
		else
		{
			visitado[u] = true; //marco la ciudad actual como visitada

			//reviso todas las ciudades vecinas 'v' conectadas desde 'u'
			for (int v = 0; v < n; v++)
			{
				if (!visitado[v])
				{
					Ruta r = mi_grafo.getRuta(u, v); //obtengo la ruta directa entre u y v
					//solo evalúo la ruta si existe y si no está cortada (estado_de_ruta == true)
					if (r.getruta_existe() && r.getestado_de_ruta())
					{
						double nuevaDist = dist[u] + r.getdistancia(); //calculo distancia pasando por u
						//si pasar por 'u' acorta el camino conocido hacia 'v', actualizo los datos
						if (nuevaDist < dist[v])
						{
							dist[v] = nuevaDist;
							anterior[v] = u; //registro que para llegar más rápido a 'v' conviene venir desde 'u'
						}
					}
				}
			}
		}
	}

	if (dist[destino] == INF)
		return false;

	distanciaTotal = dist[destino];

	//se reconstruye el camino desde destino hasta origen y luego se invierte
	for (int actual = destino; actual != -1; actual = anterior[actual])
	{
		camino.push_back(actual);
	}
	std::reverse(camino.begin(), camino.end());

	return true;
}

void __fastcall TForm1::btnCalcularViajeClick(TObject *Sender)
{
	//guardo del desplegable
	int origen = cmbViajeOrigen->ItemIndex;
	int destino = cmbViajeDestino->ItemIndex;

	if (origen == -1 || destino == -1)
	{
		ShowMessage("Selecciona origen y destino.");
		return;
	}
	if (origen == destino)
	{
		ShowMessage("Ya estás en la ciudad de destino.");
		return;
	}

	std::vector<int> camino; //vector que recibirá los índices de las ciudades del recorrido óptimo hecho por Djikstra
	double kmTotales = 0; //variable que guarda la suma total de kilómetros

    //se ejecuto Dijkstra; si encuentra un camino válido, armo el texto y actualizo el mapa
	if (CalcularDijkstra(origen, destino, camino, kmTotales))
	{
		String recorrido = "";
		for (int i = 0; i < camino.size(); i++)
		{
			int idx = camino[i];
			recorrido += String(vector_ciudades[idx].getNombre().c_str());
			if (i < camino.size() - 1)  //agrego la flecha (solo si no es la última ciudad)
				recorrido += " -> ";
		}
		camino_actual = camino;   //guardo el camino más rápido, pbMapaPaint lo pinta en rojo
		pbMapa->Invalidate();    //fuerzo el redibujado del mapa con la ruta
		lblResultadoViaje->Caption = "Distancia mínima: " + FloatToStr(kmTotales) + " km\nRecorrido: " + recorrido;

		//obtengo fecha y hora actual
		String fechaActual = Now().FormatString("dd/mm/yyyy hh:nn");
		string strFecha = AnsiString(fechaActual).c_str();
		string strOrigen = vector_ciudades[origen].getNombre();
		string strDestino = vector_ciudades[destino].getNombre();
		string strRecorrido = AnsiString(recorrido).c_str();

		//creo el registro y lo guardo en historial.bin
		Historial nuevoRegistro(strFecha, strOrigen, strDestino, strRecorrido, kmTotales);
		nuevoRegistro.guardar();
	}
	else
	{
	//si no hay conexión posible entre las ciudades, limpio el mapa y aviso en pantalla
		camino_actual.clear();
        pbMapa->Invalidate();
		lblResultadoViaje->Caption = "No existe un camino conectado entre esas ciudades.";
	}
}
