//METODO LEER
vector<Ciudad> Ciudad::leerArchivo(){
	
	//vector de objetos auxiliar
    vector<Ciudad> vector_auxiliar;
    
	ifstream archivo("ciudades.bin", ios::binary);//abro archivo.bin + r
	if(archivo){
		
		//variables aux
    	int auxID; 		
		int auxX;
		int auxY;
		string auxNombre="";	//string
		int longitud; 		//saber la cantidad de caracteres
    
		//copio lo del archivo a las variables aux (es lo que hace read)
		//El bucle evalúa la lectura del ID. Si ya no hay datos(EOF) frena solo.
        while(archivo.read((char*)&auxID, sizeof(auxID)))
        {
            archivo.read((char*)&auxX, sizeof(auxX));
            archivo.read((char*)&auxY, sizeof(auxY));
            archivo.read((char*)&longitud, sizeof(longitud));
            
            if(longitud > 0 && longitud < 500)
            {
    		char* buffer = new char[longitud + 1];
                archivo.read(buffer, longitud);
                buffer[longitud] = '\0'; // Aseguramos el fin de texto

                string auxNombre = buffer;
                delete[] buffer;

                vector_auxiliar.push_back(Ciudad(auxID, auxX, auxY, auxNombre));
            }
            
            // Creamos el objeto auxiliar y lo instaciamos con sus parametros

            //lo guardamos en el vector auxiliar de objetos

        }
    	archivo.close();//cierro archivo
    	return vector_auxiliar;
    }
    else{
    	cout<<"No se puedo abrir el archivo"<<endl;
    	return vector_auxiliar;
	}
}
//METODO ESCRIBIR 
void Ciudad::escribir(){
	
	ofstream archivo("ciudades.bin", ios::binary | ios::app | ios::out) ;//abro archivo + outfile(write) + al final
	
	if(archivo){//abrio bien
		
		int longitud =0;//variable de caracteres
		//obtengo los nuevos datos del objeto(GET)
    	int auxID = getID(); //y las guardo en auxiliares
    	int auxX = getX();
    	int auxY = getY();
		string auxNombre = getNombre();

		longitud = auxNombre.size();
        
        if(longitud > 0){
            //escribimos en orden
            archivo.write((char*)&auxID, sizeof(auxID));
            archivo.write((char*)&auxX, sizeof(auxX));
            archivo.write((char*)&auxY, sizeof(auxY));
            
            //despues guardamos el espacio a escribir
            archivo.write((char*)&longitud, sizeof(longitud)); 
            //despues escribimos el nombre
            archivo.write(&auxNombre[0], longitud); 
        }

		else{
			cout<<"*Requerimiento incumplido para guardar"<<endl;
		}
		
		archivo.close();//cierro archivo
	}
	else{//no se pudo abrir
		cout<<"No se puedo abrir el archivo"<<endl;
	}
}

Ciudad Ciudad::intanciarObjeto(){
	
	//objeto que devuelve
	Ciudad obj;
	
	//variables aux
	string nombre_aux;
	int id_aux, x_aux, y_aux;

	cin.ignore();
	//validaciones para llenar su informacion
	do{
		cout<<"Ingrese NOMBRE: ";
		getline(cin, nombre_aux);
	}while(nombre_aux == "");
	do{
		cout<<"Ingrese ID: ";
		cin>>id_aux;
	}while(id_aux<0);
	do{
		cout<<"Ingrese coordenada X: ";
		cin>>x_aux;
	}while(x_aux<0);
	do{	
		cout<<"Ingrese coordenada Y: ";
		cin>>y_aux;
	}while(y_aux<0);
	
	//setters
	obj.setNombre(nombre_aux);
	obj.setID(id_aux);
	obj.setX(x_aux);
	obj.setY(y_aux);
	
	//devuelvo el obj cargado...
	return obj;
}
bool Ciudad::eliminarCiudad(int idBuscado)
{
	vector<Ciudad> todasCiudades = leerArchivo();
    bool encontrada = false;

	//sobrescribimos el archivo vaciandolo (ios::trunc)
	ofstream archivo("ciudades.bin", ios::binary | ios::trunc);
	if (!archivo)
	return false;

	archivo.close();

	//guardamos todas menos la que coincide con el ID buscado
	for (int i = 0; i < todasCiudades.size(); i++)
	{
		if (todasCiudades[i].getID() == idBuscado)
		{
            encontrada = true;
		}
		else
		{
            todasCiudades[i].escribir();
        }
    }
    return encontrada;
}
bool Ciudad::ModificarCiudad(Ciudad CiudadModificar)
{
	vector<Ciudad> todasCiudades = leerArchivo();
    bool encontrada = false;

	//sobrescribimos el archivo vaciandolo (ios::trunc)
	ofstream archivo("ciudades.bin", ios::binary | ios::trunc);
	if (!archivo)
	return false;

	archivo.close();

	for (int i = 0; i < todasCiudades.size(); i++)
	{
		if (todasCiudades[i].getID() == idBuscado)
		{
	        CiudadModificar.escribir();
            encontrada = true;
        } else {
            todasCiudades[i].escribir();
        }
    }
    return encontrada;
}
