void __fastcall TForm1::Button_Eliminar_identificadorClick(TObject *Sender)
{
	bool flag=false;
	int indiceEliminar;
	bool encontrado=false;


	//Valido si escribio algo en el buscador
	if(EditBuscador->Text.Trim().IsEmpty())
	{
		ShowMessage("No buscaste nada");
	}
	else{
		flag=true;
	}

	if(flag==true){
		if(RadioButtonName->Checked){//Eliminar por nombre

		   //variable aux
		   string nombreBuscado = AnsiString(EditBuscador->Text).c_str();

			for(int i=0; i<vector_ciudades.size(); i++){

				if(nombreBuscado == vector_ciudades[i].getNombre()){
				   encontrado=true;
				   indiceEliminar = i; //indice a eliminar
				}
			}

		}
		else if(RadioButtonID->Checked){//Eliminar por ID
			//variable aux
			int IDBuscado = StrToInt(EditBuscador->Text);

			for(int i=0; i<vector_ciudades.size(); i++){
				if(IDBuscado == vector_ciudades[i].getID())
				{
					encontrado=true;
					indiceEliminar=i;
				}
			}

		}

		//Fue encontrada??
		if(encontrado==false){
			   ShowMessage("Ciudad NO encontrada");
		}
		else{
				ShowMessage("Ciudad encontrada,Eliminando...");
				//elimino con el indice
				vector_ciudades.erase(vector_ciudades.begin()+indiceEliminar);
				//rescribo el archivo con la ciudad eliminada
				Ciudad::reescribir(vector_ciudades);
				actualizarCuadro();
				//vacio el buscador
				EditBuscador->Text="";
				PanelEliminar->Visible=false;
		}
	}
	else{
		ShowMessage("Requerimiento incumplido. Saliendo...");
		PanelEliminar->Visible=false;
	}
}
