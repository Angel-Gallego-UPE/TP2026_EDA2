# Project: Proyecto 1
# Makefile created by Red Panda C++ 3.4.3279

CXX      = "g++.exe"
CC       = "gcc.exe"
WINDRES  = "windres.exe"
RM       = del /q /f
CD       = cd /d
LIBS     = "-static"
INCS     = 
CXXINCS  = 
CXXFLAGS = $(CXXINCS) 
CFLAGS   = $(INCS) 
NASM_FLAGS   =  "-f" "elf64"
WINDRESFLAGS = 
OBJ      = main.o desarr_clase.o Ruta.o Grafo.o
BIN      = Proyecto_01.exe
LINKOBJ  = "main.o" "desarr_clase.o" "Ruta.o" "Grafo.o"
CLEANOBJ = "main.o" "desarr_clase.o" "Ruta.o" "Grafo.o" "Proyecto_01.exe"

.PHONY: all all-before all-after clean clean-custom

all: all-before $(BIN) all-after

clean: clean-custom
	-$(RM) $(CLEANOBJ) >NUL 2>&1

Proyecto_01.exe: $(OBJ)

	$(CXX) $(LINKOBJ) -o "Proyecto_01.exe" $(LIBS)

main.o: main.cpp Ruta.h clase.h Grafo.h
	$(CXX) -c "main.cpp" -o "main.o" $(CXXFLAGS)  -finput-charset=UTF-8 -fexec-charset=windows-1252

desarr_clase.o: desarr_clase.cpp clase.h
	$(CXX) -c "desarr_clase.cpp" -o "desarr_clase.o" $(CXXFLAGS)  -finput-charset=UTF-8 -fexec-charset=windows-1252

Ruta.o: Ruta.cpp Ruta.h
	$(CXX) -c "Ruta.cpp" -o "Ruta.o" $(CXXFLAGS) 

Grafo.o: Grafo.cpp Ruta.h Grafo.h
	$(CXX) -c "Grafo.cpp" -o "Grafo.o" $(CXXFLAGS)  -finput-charset=UTF-8 -fexec-charset=windows-1252
